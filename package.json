{
  "$schema": "https://json.schemastore.org/package",
  "name": "smart-exporter",
  "displayName": "Smart Exporter & Codebase Purifier",
  "description": "Codebase purification, AST skeletonization, and persistent export pipelines",
  "version": "1.2.1",
  "publisher": "mersel",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:smart-exporter.exportFiles",
    "onCommand:smart-exporter.toggleExportFile",
    "onCommand:smart-exporter.selectProfile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smart-exporter.exportFiles",
        "title": "Smart Exporter: Open Dashboard"
      },
      {
        "command": "smart-exporter.toggleExportFile",
        "title": "Smart Exporter: Toggle in Export List",
        "icon": "$(checklist)"
      },
      {
        "command": "smart-exporter.selectProfile",
        "title": "Smart Exporter: Select Active Profile"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "smart-exporter.toggleExportFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "z_smartExporter@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "smart-exporter.toggleExportFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "z_smartExporter@1"
        }
      ],
      "editor/title": [
        {
          "command": "smart-exporter.toggleExportFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "1_smartExporter@1"
        }
      ],
      "explorer/context": [
        {
          "command": "smart-exporter.toggleExportFile",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "7_smartExporter@1"
        }
      ]
    }
  },
  "bin": {
    "purification": "./bin/cli.js",
    "skeletonize": "./bin/cli.js"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-git-tag-version --allow-missing-repository"
  }
}
